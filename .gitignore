# Build output and dependencies — regenerated by the build, never committed.
node_modules/
dist/
lib/
*.tsbuildinfo

# Packaged artifacts. The installer is published as a GitHub Release asset, not committed:
# it is a single 327 MB file whose contents are fully reproducible from this tree.
win7-delivery/*.exe
win7-delivery/*.zip
*.exe
*.msi
*.dmg
*.AppImage
*.deb

# Downloaded toolchains and reference archives kept only for local verification.
verify/
*.zip
*.7z

# The optional convenience rollup (476 MB). It duplicates updates the four bundled prerequisite
# packages already carry, so it is a Release asset rather than part of the source tree.
win7-delivery/win7-prerequisites-optional/

# Scratch space: overlay backups, downloaded wheels, probe outputs, VM captures.
# Nothing here is needed to build or run the product.
work/

# Crash and diagnostic captures.
work/vm-results/
work/vm-dumps/
work/electron-symbols/
*.dmp
dsh-desktop-evidence-*.zip

# Logs and transient probes.
*.log
.probe-write.txt

# Electron/Chromium caches.
Cache/
Code Cache/
GPUCache/
DawnCache/
DawnGraphiteCache/
DawnWebGPUCache/
ShaderCache/
GrShaderCache/

# OS noise.
Thumbs.db
desktop.ini
.DS_Store
